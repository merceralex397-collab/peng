{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peng",
  "version": "0.1.0",
  "identifier": "app.peng.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "Peng",
        "width": 1440,
        "height": 900,
        "minWidth": 850,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

